// Схема БД цифровой визитки. Источник истины — prisma/schema.prisma.
// Docs: https://dbml.dbdiagram.io/docs

Table Profile {
  id uuid [pk]
  name text [not null]
  description text [not null]
  headline varchar(100)
}

Table Link {
  id uuid [pk]
  name text [not null]
  url text [not null]
  sortOrder int [not null]
  profileId uuid [not null]

  indexes {
    profileId
  }
}

Table Skill {
  id uuid [pk]
  name text [not null]
  sortOrder int [not null]
  profileId uuid [not null]

  indexes {
    (profileId, name) [unique]
  }
}

Table Experience {
  id uuid [pk]
  company text [not null]
  position text [not null]
  location text
  description text
  startDate date [not null]
  endDate date [note: 'null — по настоящее время']
  profileId uuid [not null]

  indexes {
    profileId
  }
}

Table Achievement {
  id uuid [pk]
  text text [not null]
  sortOrder int [not null]
  experienceId uuid [not null]

  indexes {
    experienceId
  }
}

Table Project {
  id uuid [pk]
  name text [not null]
  description text
  url text
  sortOrder int [not null]
  profileId uuid [not null]

  indexes {
    profileId
  }
}

Table ProjectSkill {
  projectId uuid [not null]
  skillId uuid [not null]

  indexes {
    (projectId, skillId) [pk]
  }
}

Ref: Link.profileId > Profile.id [delete: cascade]
Ref: Skill.profileId > Profile.id [delete: cascade]
Ref: Experience.profileId > Profile.id [delete: cascade]
Ref: Project.profileId > Profile.id [delete: cascade]
Ref: Achievement.experienceId > Experience.id [delete: cascade]
Ref: ProjectSkill.projectId > Project.id [delete: cascade]
Ref: ProjectSkill.skillId > Skill.id [delete: cascade]
